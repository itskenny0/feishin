# Swift Package Manager. Package.swift is regenerated by `npx cap sync ios`
# and embeds machine-specific pnpm store paths (the `.pnpm/<pkg>@<ver>_…`
# directories), so committing it would bake in this machine's resolution.
# CI regenerates it during the release build — exactly like the Android
# capacitor.config.json above. Run `pnpm ios:sync` before opening Xcode.
App/CapApp-SPM/Package.swift

